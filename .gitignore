# RAGentic Monorepo .gitignore

# Environment & Secrets
.env
.env.*
!.env.example
!*.env.example
backend/.env
frontend/.env.local
frontend/.env.*.local

# Python / Backend
backend/.venv/
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
# Python build / venv
/lib/
/lib64/
!frontend/src/lib/
!frontend/src/lib/**
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js / Frontend
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Terraform / Infrastructure
infra/terraform/.terraform/
.terraform/
*.tfstate
*.tfstate.*
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
infra/terraform/terraform.tfvars
!infra/terraform/terraform.tfvars.example
crash.log
crash.*.log

# Milvus & MinIO local storage
volumes/
data/
*.db
*.sqlite3

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
