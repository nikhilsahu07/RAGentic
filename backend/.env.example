# ──────────────────────────────────────────────
# RAGentic Backend — Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-2.5-flash

# Milvus Vector Store (Native system service or container on localhost:19530)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ragentic_chunks

# S3 / MinIO Storage
S3_BUCKET=ragentic-docs
# Set to http://localhost:9000 for local MinIO; leave empty for real AWS S3
S3_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# RAG Tuning
BM25_TOP_K=20
DENSE_TOP_K=20
RRF_K=60

# Application
ENV=local
LOG_LEVEL=INFO
CORPUS_DIR=./corpus
